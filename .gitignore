# ROS 2 and colcon build products
**/build/
**/install/
**/log/
**/.cache/

# Generated analysis outputs. Recreate them with the commands in
# docs/WORKSPACE_GUIDE.md rather than committing results at workspace roots.
fanuc_cbf/*.csv
fanuc_cbf/*.svg
fanuc_cbf/*.html
official_fanuc_ws/*.csv
official_fanuc_ws/*.svg
official_fanuc_ws/*.html

# Python environments and local tooling
.venv/
**/.venv/
**/.claude/
**/__pycache__/
*.py[cod]

# Nested repository metadata is not part of the aggregate repository. The
# original metadata is preserved locally as *.git-archive directories.
**/.git/
**/.git-archive/
**/.git*

# Editor and OS files
.vscode/
**/.vscode/
*.swp
.DS_Store
